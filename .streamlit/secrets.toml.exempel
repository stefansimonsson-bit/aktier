# Kopiera innehållet till "Secrets" i Streamlit Cloud (App settings → Secrets).
# Utan detta sparas innehaven bara tillfälligt i molnet.
[github]
token = "github_pat_..."          # fine-grained token med Contents: Read and write, bara för det här repot
repo = "ditt-anvandarnamn/aktie-app"
branch = "data"                   # innehaven sparas i en egen gren så att appen inte startas om vid varje sparning
